<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ExtensionManifest
  Version="6.0"
  ExtensionBundleId="com.fxpremiere.suite"
  ExtensionBundleVersion="1.0.0"
  ExtensionBundleName="FX Premiere"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.fxpremiere.panel" Version="1.0.0" />
    <Extension Id="com.fxpremiere.service" Version="1.0.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[14.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.fxpremiere.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./panel/index.html</MainPath>
          <ScriptPath>./host/fxpremiere.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--v=0</Parameter>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Modeless</Type>
          <Menu>FX Premiere</Menu>
          <!-- Everything the panel is ever allowed to be. CEP clamps resizeContent to these, so a
               sheet asking for more than the maximum opens quietly cut down to it, and a dialog
               whose maximum equals its minimum cannot be resized by hand at all: the border does
               not even take a resize cursor. They pair with WINDOW_BOUNDS in window-size.ts, and
               scripts/test-panel.mjs fails if the two stop agreeing.

               The minimum comes before the maximum because that is the order every extension that
               works writes them in, Adobe's own among them. Written the other way round the window
               could be dragged smaller but not larger, which is a maximum being read past rather
               than a maximum being read: the size of the pair is not the only thing about it that
               has to be right. -->
          <Geometry>
            <!-- What the palette asks for on a first run, with four slots and nothing used yet: the
                 window opens at it instead of being resized a moment later. Once there are recents
                 to show, more favourite rows, or a size set by dragging the corner, the panel asks
                 for that before its first paint. From the numbers in panel.css: 36 + 4 slots of 116
                 + 3 gaps of 6 + 16 across, and 44 + 1 + 32 + a 47 tall bar + 7 rows of 28 + 12
                 down. -->
            <Size>
              <Width>534</Width>
              <Height>332</Height>
            </Size>
            <MinSize>
              <Width>380</Width>
              <Height>120</Height>
            </MinSize>
            <!-- Far past any screen, so what stops the drag is the screen rather than a number
                 guessed here: the CC Libraries panel states 7680 for the same reason. -->
            <MaxSize>
              <Width>7680</Width>
              <Height>7680</Height>
            </MaxSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./icons/icon-dark.png</Icon>
            <Icon Type="DarkNormal">./icons/icon-light.png</Icon>
            <Icon Type="RollOver">./icons/icon-dark.png</Icon>
            <Icon Type="DarkRollOver">./icons/icon-light.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
    <Extension Id="com.fxpremiere.service">
      <DispatchInfo>
        <Resources>
          <MainPath>./service/index.html</MainPath>
          <ScriptPath>./host/fxpremiere.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--v=0</Parameter>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>false</AutoVisible>
          <StartOn>
            <Event>com.adobe.csxs.events.ApplicationActivate</Event>
            <Event>applicationActivate</Event>
          </StartOn>
        </Lifecycle>
        <UI>
          <Type>Custom</Type>
          <Geometry>
            <Size>
              <Width>1</Width>
              <Height>1</Height>
            </Size>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
