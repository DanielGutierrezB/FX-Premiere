<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ExtensionManifest
  Version="6.0"
  ExtensionBundleId="com.fxpremiere.suite"
  ExtensionBundleVersion="1.0.0"
  ExtensionBundleName="FX Premiere"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.fxpremiere.panel" Version="1.0.0" />
    <Extension Id="com.fxpremiere.service" Version="1.0.0" />
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="PPRO" Version="[14.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.fxpremiere.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./panel/index.html</MainPath>
          <ScriptPath>./host/fxpremiere.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--v=0</Parameter>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Modeless</Type>
          <Menu>FX Premiere</Menu>
          <Geometry>
            <Size>
              <Width>620</Width>
              <Height>460</Height>
            </Size>
            <MinSize>
              <Width>420</Width>
              <Height>180</Height>
            </MinSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./icons/icon-light.png</Icon>
            <Icon Type="DarkNormal">./icons/icon-dark.png</Icon>
            <Icon Type="RollOver">./icons/icon-light.png</Icon>
            <Icon Type="DarkRollOver">./icons/icon-dark.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
    <Extension Id="com.fxpremiere.service">
      <DispatchInfo>
        <Resources>
          <MainPath>./service/index.html</MainPath>
          <ScriptPath>./host/fxpremiere.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--v=0</Parameter>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>false</AutoVisible>
          <StartOn>
            <Event>com.adobe.csxs.events.ApplicationActivate</Event>
            <Event>applicationActivate</Event>
          </StartOn>
        </Lifecycle>
        <UI>
          <Type>Custom</Type>
          <Geometry>
            <Size>
              <Width>1</Width>
              <Height>1</Height>
            </Size>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
